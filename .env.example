# Plantilla local sin secretos. Genere claves reales únicamente en su .env ignorado.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3002
API_PORT=4312
WEB_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:4312
APP_SESSION_COOKIE_NAME=crashmemory_v03_session
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_TTL_SECONDS=43200
CREDENTIAL_ACTIVE_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYS_JSON=
OAUTH_STATE_SECRET_BASE64=
POSTGRES_DB=crashmemory_v03
DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54331/crashmemory_v03
TEST_DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54331/crashmemory_v03
REDIS_URL=redis://localhost:6391
OUTBOX_DISPATCH_INTERVAL_MS=5000
OBJECT_STORAGE_ENDPOINT=http://localhost:9013
OBJECT_STORAGE_BUCKET=crashmemory
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
COMPOSE_PROJECT_NAME=crashmemory-v03
POSTGRES_PORT=54331
REDIS_PORT=6391
MINIO_PORT=9013
MINIO_CONSOLE_PORT=9014

# Se usarán desde V04, V05 y V07. Déjelas vacías en la demo.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_PUBSUB_AUDIENCE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL_MS=10000
# Sólo active avisos automáticos tras medir y aprobar la calidad. El vínculo del
# bot sigue disponible con la clave de cifrado configurada.
NOTIFICATIONS_AUTOMATIC_ENABLED=false
MODEL_PROVIDER=
MODEL_API_KEY=
# V05: una clave no habilita salida remota. No copie secretos al repositorio.
MODEL_NAME=gpt-5.6-terra
MODEL_REASONING_EFFORT=medium
MODEL_REMOTE_ENABLED=false
MODEL_PROJECT_DATA_CONTROLS_CONFIRMED=false
MODEL_TIMEOUT_MS=30000
MODEL_MAX_INPUT_TOKENS=16000
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_PRICING_VERSION=openai-gpt-5.6-terra-2026-09-21
MODEL_INPUT_USD_PER_MILLION=2
MODEL_OUTPUT_USD_PER_MILLION=12
