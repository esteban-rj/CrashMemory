# Plantilla local sin secretos. Genere claves reales únicamente en su .env ignorado.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3002
API_PORT=4312
WEB_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:4312
APP_SESSION_COOKIE_NAME=crashmemory_v03_session
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_TTL_SECONDS=43200
CREDENTIAL_ACTIVE_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYS_JSON=
OAUTH_STATE_SECRET_BASE64=
POSTGRES_DB=crashmemory_v03
DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54331/crashmemory_v03
TEST_DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54331/crashmemory_v03
REDIS_URL=redis://localhost:6391
OUTBOX_DISPATCH_INTERVAL_MS=5000
OBJECT_STORAGE_ENDPOINT=http://localhost:9013
OBJECT_STORAGE_BUCKET=crashmemory
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
COMPOSE_PROJECT_NAME=crashmemory-v03
POSTGRES_PORT=54331
REDIS_PORT=6391
MINIO_PORT=9013
MINIO_CONSOLE_PORT=9014

# Se usarán desde V04, V05 y V07. Déjelas vacías en la demo.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_PUBSUB_AUDIENCE=
TELEGRAM_BOT_TOKEN=
MODEL_PROVIDER=
MODEL_API_KEY=
