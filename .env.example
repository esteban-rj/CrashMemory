# Plantilla local sin secretos. Genere claves reales únicamente en su .env ignorado.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3004
API_PORT=4314
WEB_PORT=3004
API_INTERNAL_URL=http://127.0.0.1:4314
APP_SESSION_COOKIE_NAME=crashmemory_v04_session
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_TTL_SECONDS=43200
CREDENTIAL_ACTIVE_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYS_JSON=
OAUTH_STATE_SECRET_BASE64=
POSTGRES_DB=crashmemory_v04
DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54332/crashmemory_v04
TEST_DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54332/crashmemory_v04
REDIS_URL=redis://localhost:6392
OUTBOX_DISPATCH_INTERVAL_MS=5000
OBJECT_STORAGE_ENDPOINT=http://localhost:9015
OBJECT_STORAGE_BUCKET=crashmemory-v04
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
COMPOSE_PROJECT_NAME=crashmemory-v04
POSTGRES_PORT=54332
REDIS_PORT=6392
MINIO_PORT=9015
MINIO_CONSOLE_PORT=9016

# Se usarán desde V04, V05 y V07. Déjelas vacías en la demo.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
