# Plantilla local sin secretos. Genere claves reales únicamente en su .env ignorado.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3001
API_PORT=4311
WEB_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:4311
APP_SESSION_COOKIE_NAME=crashmemory_v02_session
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_TTL_SECONDS=43200
CREDENTIAL_ACTIVE_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYS_JSON=
OAUTH_STATE_SECRET_BASE64=
POSTGRES_DB=crashmemory_v02
DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54330/crashmemory_v02
TEST_DATABASE_URL=postgresql://crashmemory:crashmemory@localhost:54330/crashmemory_v02
REDIS_URL=redis://localhost:6390
OBJECT_STORAGE_ENDPOINT=http://localhost:9011
OBJECT_STORAGE_BUCKET=crashmemory
COMPOSE_PROJECT_NAME=crashmemory-v02
POSTGRES_PORT=54330
REDIS_PORT=6390
MINIO_PORT=9011
MINIO_CONSOLE_PORT=9012

# Se usarán desde V04, V05 y V07. Déjelas vacías en la demo.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
