# Copie a .env (ignorado por Git) y complete URLs/claves privadas allí.
# El origen público de la web también sirve /api mediante rewrite a la API.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
API_PORT=4310
WEB_PORT=3000
API_INTERNAL_URL=http://127.0.0.1:4310
APP_SESSION_COOKIE_NAME=crashmemory_session
APP_SESSION_COOKIE_SECURE=false
APP_SESSION_TTL_SECONDS=43200
SEED_EMAIL=
SEED_PASSWORD=
SEED_TIME_ZONE=America/Bogota

COMPOSE_PROJECT_NAME=crashmemory-local
POSTGRES_DB=crashmemory_local
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
REDIS_PORT=6389
MINIO_PORT=9009
MINIO_CONSOLE_PORT=9010
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6389
OUTBOX_DISPATCH_INTERVAL_MS=5000
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9009
OBJECT_STORAGE_BUCKET=crashmemory-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

CREDENTIAL_ACTIVE_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYS_JSON=
OAUTH_STATE_SECRET_BASE64=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/v1/gmail/callback
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GMAIL_PUBSUB_TOPIC=
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_INTERVAL_MS=300000

TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL_MS=10000
# Sólo tras medir/aprobar la calidad; no se activa por vincular el bot.
NOTIFICATIONS_AUTOMATIC_ENABLED=false

# Sin adaptador local de producción: local-only deja revisión manual.
EXTRACTION_DEFAULT_PRIVACY_PROFILE=local-only
MODEL_API_KEY=
MODEL_NAME=gpt-5.6-terra
MODEL_REASONING_EFFORT=medium
MODEL_REMOTE_ENABLED=false
MODEL_PROJECT_DATA_CONTROLS_CONFIRMED=false
MODEL_TIMEOUT_MS=30000
MODEL_MAX_INPUT_TOKENS=16000
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_PRICING_VERSION=openai-gpt-5.6-terra-2026-09-21
MODEL_INPUT_USD_PER_MILLION=2.5
MODEL_OUTPUT_USD_PER_MILLION=12

# Journal/archivo siempre fuera del checkout, de dumps y de Git.
LIFECYCLE_JOURNAL_PATH=
LIFECYCLE_JOURNAL_KEY_BASE64=
LIFECYCLE_BACKUP_KEY_BASE64=
LIFECYCLE_PG_CONTAINER=
LIFECYCLE_DOCKER_CONTEXT=
