{
  "name": "@crashmemory/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "budget:set": "tsx src/cli/model-budget.ts set",
    "budget:ledger": "tsx src/cli/model-budget.ts ledger"
  },
  "dependencies": {
    "@crashmemory/canonical-model": "workspace:*",
    "@crashmemory/contracts": "workspace:*",
    "@crashmemory/security": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
